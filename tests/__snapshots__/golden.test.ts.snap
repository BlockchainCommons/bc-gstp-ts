// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`freeze > builders, equality, tables and the guard 1`] = `
[
  "a.withNote(note) changes a = "false \\"\\""",
  "equals across documents with the same XID = boolean:false",
  "XIDDocument.equals of those documents = boolean:false",
  "GSTP_ERROR_CODES frozen = boolean:true",
  "details frozen = boolean:true",
  "forged error passes the guard = boolean:false",
  "envelope(cause) message = "boom"",
]
`;

exports[`freeze > continuation fields that are not leaves 1`] = `
[
  "wrapped id, opened with it = throw:GstpError[Envelope]|invalid format",
  "id with an assertion, opened with another id = throw:GstpError[ContinuationIdInvalid]|continuation ID invalid",
  "wrapped validUntil, opened later = throw:GstpError[Envelope]|invalid format",
  "validUntil that is not a date = throw:GstpError[Envelope]|dcbor error: the decoded CBOR value was not the expected type",
  "id that is not an ARID = throw:GstpError[Envelope]|dcbor error: the decoded CBOR value was not the expected type",
  "two ids = throw:GstpError[Envelope]|more than one assertion matches the predicate",
  "not wrapped = throw:GstpError[Envelope]|cannot unwrap an envelope that was not wrapped",
]
`;

exports[`freeze > envelope failures and parameter extraction 1`] = `
[
  "parameter(dup) = throw:GstpError[Envelope]|more than one assertion matches the predicate",
  "extractObjectForParameter(dup) = throw:GstpError[Envelope]|more than one assertion matches the predicate",
  "extractObjectsForParameter(dup) = "number:1,number:2"",
  "extractObjectForParameter(nested) = throw:GstpError[Envelope]|dcbor error: the decoded CBOR value was not the expected type",
  "extractObjectForParameter(missing) = throw:GstpError[Envelope]|no assertion matches the predicate",
  "extractOptionalObjectForParameter(missing) = undefined",
  "extractObjectsForParameter(p, expectInteger)[0] = number:42",
  "extractObjectForParameter(big, expectInteger) = bigint:1152921504606846977",
  "extractObjectForParameter(p, expectText) = throw:GstpError[Envelope]|dcbor error: the decoded CBOR value was not the expected type",
  "objectForParameter(missing) = throw:GstpError[Envelope]|no assertion matches the predicate",
  "failure.result = throw:GstpError[Envelope]|general error: Cannot get result from failed response",
  "success.error = throw:GstpError[Envelope]|general error: Cannot get error from successful response",
  "failure.withResult = throw:GstpError[Envelope]|general error: Cannot set result on a failed response",
  "success.withError = throw:GstpError[Envelope]|general error: Cannot set error on a successful response",
]
`;

exports[`freeze > state on a failed response 1`] = `
[
  "failure.withState = throw:GstpError[StateOnFailedResponse]|Cannot set state on a failed response",
  "failure with state = throw:GstpError[StateOnFailedResponse]|Cannot set state on a failed response",
  "earlyFailure.withState = throw:GstpError[StateOnFailedResponse]|Cannot set state on a failed response",
]
`;

exports[`freeze > the JavaScript input domain 1`] = `
[
  "Continuation.from validUntil NaN = throw:TypeError|validUntil must be a valid Date or a CborDate",
  "Continuation.from validDuration NaN = throw:TypeError|validDuration must be a finite, non-negative number of milliseconds",
  "SealedRequest.from id string = throw:TypeError|id must be an ARID",
  "withDate NaN = throw:TypeError|date must be a valid Date or a CborDate",
  "fromEnvelope without recipient = throw:TypeError|recipient must be a Decrypter (the recipient's private keys)",
  "SealedEvent.fromEnvelope without content = "text"",
  "toEnvelope validUntil CborDate = "request(ARID(c66be27d)) [ 'body': «\\"f\\"»,"",
  "fromEnvelope now CborDate = ARID(c66be27d)",
]
`;

exports[`freeze > wrapped-error messages 1`] = `
[
  "wrong recipient = throw:GstpError[Envelope]|unknown recipient",
  "unsigned message = throw:GstpError[Envelope]|cannot unwrap an envelope that was not wrapped",
  "numeric event content read as text = throw:GstpError[Envelope]|general error: Failed to parse content",
  "sender that is not a document = throw:GstpError[XID]|CBOR error",
  "no sender = throw:GstpError[Envelope]|no assertion matches the predicate",
]
`;

